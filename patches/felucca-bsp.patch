         if (dt > max_us) { *took_us = dt; return -4; }
@@ -210,6 +217,51 @@ static RAMFN int fl_erase4k_ram(uint32_t off, uint32_t *took_us)
     return rc;
 }
 
+/* One slice of a 4 KiB erase (start: the command, else a resume, 7Ah), the part busy at most slice_us, then
+ * suspended (75h) so XIP and the interrupts can run until the next slice: 1 = still erasing (suspended), 0 = done,
+ * < 0 = error. XIP never comes back while the part is busy: a part that does not suspend within 200 us has its erase
+ * waited out here (as fl_erase4k_ram). Suspended = SR2 bit 7 or 2 (SUS1 / SUS2, Puya / GD; Winbond's SUS is bit 7). */
+static RAMFN int fl_erase_slice_ram(uint32_t off, int start, uint32_t slice_us)
+{
+    fl_saved_t s; int rc = 1; uint32_t t0, took;
+    if (!FL_RANGE_OK(off, 0x1000u) || (off & 0xFFFu))
+        return -1;
+    if (fl_enter(&s)) return -2;
+    if (start) {
+        fl_wren();
+        if (!(fl_rdsr(0x05) & 2u)) { fl_exit(&s); return -3; }
+        fl_cs(0); fl_tx(0x20); fl_addr(off); fl_cs(1);
+    } else {
+        fl_cs(0); fl_tx(0x7A); fl_cs(1);
+    }
+    t0 = T4_CNT;
+    for (;;) {
+        fl_busy();
+        if (!(fl_rdsr(0x05) & 1u)) {              /* idle: done, or the resume not taken yet (again) */
+            if (!(fl_rdsr(0x35) & 0x84u)) { rc = 0; break; }
+            fl_cs(0); fl_tx(0x7A); fl_cs(1);
+        }
+        if ((T4_CNT - t0) / 24u >= slice_us) {
+            fl_cs(0); fl_tx(0x75); fl_cs(1);
+            t0 = T4_CNT;
+            while (fl_rdsr(0x05) & 1u) {
+                fl_busy();
+                if ((T4_CNT - t0) / 24u > 200u) { /* no suspend: wait it out */
+                    rc = fl_wait_ready(500000u, &took);
+                    break;
+                }
+            }
+            if (rc == 1 && !(fl_rdsr(0x35) & 0x84u))
+                rc = 0;                           /* it finished just before the suspend */
+            break;
+        }
+    }
+    if (rc != 1)
+        fl_inval(off, 4096u);
+    fl_exit(&s);
+    return rc;
+}
