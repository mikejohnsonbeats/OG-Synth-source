+/* the LED scan while the interrupts are off for the flash (an erase slice, a page program: up to ~3 ms): the RAM
+ * driver's busy loops run fm1_led_ram_step (fm1_flash.h FL_BUSY_STEP, inlined: RAM code calls nothing), which goes on
+ * with the columns as fm1_input_tick lights them (lit, the dim pulse, the mid level; no keys read). Dark lines there
+ * dimmed every LED by a third for a save. Main loop, the interrupts off: fm1_led_ram_begin, the flash op,
+ * fm1_led_ram_end (the tick goes on from the column lit now) */
+static volatile struct { uint32_t t; uint8_t col, on; } fm1__ram_scan;
+static inline __attribute__((always_inline)) void fm1__ram_lines(uint32_t m)
+{
+    uint32_t a = FM1_PR(FM1_PA, FM1_OUT) & ~((1u << 9) | (1u << 10));
+    uint32_t h = FM1_PR(FM1_PH, FM1_OUT) & ~((1u << 6) | (1u << 9));
+    FM1_PR(FM1_PA, FM1_OUT) = a | (m & 2u) << 8 | (m & 4u) << 8;
+    FM1_PR(FM1_PH, FM1_OUT) = h | (m & 8u) << 3 | (m & 16u) << 5;
+}
+static inline __attribute__((always_inline)) void fm1_led_ram_step(void)
+{
+    uint32_t t = FM1_T4_CNT, n, w, i, lit, dim;
+    if (!fm1__ram_scan.on || t - fm1__ram_scan.t < FM1_LED_TICK_US * FM1_TICKS_PER_US)
+        return;
+    fm1__ram_scan.t = t;
+    n = fm1__ram_scan.col + 1u >= FM1_NCOL ? 0u : fm1__ram_scan.col + 1u;
+    w = 0xFFFFu ^ (1u << n) ^ (n < 2u ? 1u << (11u + n) : 0u);
+    fm1__ram_lines(0);
+    for (i = 0; i < 16u; i++) {                    /* fm1__sr_word: read-modify-write per edge (the 595) */
+        if (w & (0x8000u >> i))
+            FM1_PR(FM1_PA, FM1_OUT) |= 1u << 4;
+        else
+            FM1_PR(FM1_PA, FM1_OUT) &= ~(1u << 4);
+        FM1_PR(FM1_PA, FM1_OUT) |= 1u << 3;
+        FM1_PR(FM1_PA, FM1_OUT) &= ~(1u << 3);
+    }
+    FM1_PR(FM1_PA, FM1_OUT) |= 1u << 1;
+    FM1_PR(FM1_PA, FM1_OUT) &= ~(1u << 1);
+    if (n == 0u)
+        fm1__mid_ph = (uint8_t)(fm1__mid_ph + 1u >= fm1__mid_n ? 0u : fm1__mid_ph + 1u);
+    lit = fm1_led[n] | (!fm1__mid_ph ? fm1_led_mid[n] : 0u);
+    dim = (fm1_led_dim[n] | fm1_led_breath[n]) & ~lit;
+    if (dim) {
+        uint32_t t1 = FM1_T4_CNT;
+        fm1__ram_lines(lit | dim);
+        while (FM1_T4_CNT - t1 < fm1__dim_t)
+            ;
+    }
+    fm1__ram_lines(lit);
+    fm1__ram_scan.col = (uint8_t)n;
+}
+#define FL_BUSY_STEP() fm1_led_ram_step()
+static void fm1_led_ram_begin(void)
+{
+    if (fm1_an.pend)                               /* (the probe's PA10 and a driven row back first) */
+        fm1__an_take();
+    fm1__ram_scan.col = fm1__tick_col;
+    fm1__ram_scan.t = fm1_in_stat.last;
+    fm1__ram_scan.on = 1;
+}
+static void fm1_led_ram_end(void)
+{
+    fm1__ram_scan.on = 0;
+    fm1__tick_col = fm1__ram_scan.col;
+    fm1_in_stat.last = fm1__ram_scan.t;
+}
