+/* OGS: the current copy read in place (plat.h). The same choice as st_current (the valid header with the higher seq, A
+ * on a tie; a payload with a bad CRC hands over to the other copy), the headers read through XIP; a payload's CRC is
+ * checked once per copy, seq and CRC (st_vw): a list of names costs two headers a name */
+static struct {
+    uint32_t seq, crc;
+    uint8_t copy, ok;
+} st_vw[OBJ_NOBJ];
+static const st_hdr_t *st_vhead(uint32_t obj, uint32_t copy)
+{
+    uint32_t base = st_sector(obj, copy);
+    const st_hdr_t *h;
+    if (!PLAT_DATA_OK(base, ST_SECTOR))
+        return 0;
+    h = (const st_hdr_t *)FL_XIP(base);
+    if (h->magic != ST_MAGIC || h->type != obj || h->len > ST_PAYLOAD_MAX || h->hcrc != st_crc32(h, sizeof *h - 4u))
+        return 0;
+    return h;
+}
+static const uint8_t *st_vbody(uint32_t obj, uint32_t copy, const st_hdr_t *h)
+{
+    const uint8_t *p = (const uint8_t *)FL_XIP(st_sector(obj, copy) + ST_PAYLOAD_OFF);
+    if (!(st_vw[obj].ok && st_vw[obj].copy == copy && st_vw[obj].seq == h->seq && st_vw[obj].crc == h->crc)) {
+        if (st_crc32(p, h->len) != h->crc)
+            return 0;
+        st_vw[obj].seq = h->seq;
+        st_vw[obj].crc = h->crc;
+        st_vw[obj].copy = (uint8_t)copy;
+        st_vw[obj].ok = 1;
+    }
+    return p;
+}
+const uint8_t *plat_store_view(uint32_t obj, uint32_t *n)
+{
+    const st_hdr_t *a, *b, *h = 0;
+    const uint8_t *p = 0;
+    if (!flash_ok || obj >= OBJ_NOBJ)
+        return 0;
+    a = st_vhead(obj, 0);
+    b = st_vhead(obj, 1);
+    if (b && (!a || b->seq > a->seq) && (p = st_vbody(obj, 1, b)) != 0)
+        h = b;
+    else if (a && (p = st_vbody(obj, 0, a)) != 0)
+        h = a;
+    else if (b && (p = st_vbody(obj, 1, b)) != 0)
+        h = b;
+    if (!p || !h->len)                            /* (an empty object is none, as st_load) */
+        return 0;
+    *n = h->len;
+    return p;
+}
 
